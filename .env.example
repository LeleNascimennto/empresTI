# Supabase: valores públicos que podem ser usados no navegador
NEXT_PUBLIC_SUPABASE_URL=https://.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON

# Prisma: conexão de runtime pelo pooler Supavisor (porta 6543)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true&connection_limit=1

# Prisma: conexão direta, usada somente para migrations (porta 5432)
DIRECT_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Supabase: somente no servidor; nunca usar o prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# Sentry: preencher quando o rastreamento de erros for configurado
SENTRY_DSN=SUA_DSN_DO_SENTRY
